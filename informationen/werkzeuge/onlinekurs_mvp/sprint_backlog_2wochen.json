          "Validierungsfehler enthalten Feldpfad und Grund"
        ],
        "dependencies": []
      },
      {
        "id": "MVP-002",
        "title": "A1 Pilot Lesson integrieren",
        "priority": "P0",
        "estimate_story_points": 3,
        "owner_role": "Content",
        "acceptance_criteria": [
          "Lesson a1_kursstart_python_basis ist ladbar",
